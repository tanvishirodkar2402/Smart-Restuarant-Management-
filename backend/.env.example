PROJECT_NAME="Smart Restaurant Management System"
SECRET_KEY="your-secret-jwt-key-here"

# Database Configuration
MYSQL_USER=root
MYSQL_PASSWORD=your_db_password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=smart_restaurant

# Set to true to automatically fallback to local SQLite database if MySQL server is not running
USE_SQLITE_FALLBACK=true

# Frontend URL for QR codes and client links
FRONTEND_URL=http://localhost:5173
